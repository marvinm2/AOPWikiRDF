@prefix : <https://aopwiki.rdf.bigcat-bioinformatics.org/> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://aopwiki.rdf.bigcat-bioinformatics.org/sparql/>	a	sd:Service ;
	sd:endpoint	<https://aopwiki.rdf.bigcat-bioinformatics.org/sparql/> ;
	sd:supportedLanguage	sd:SPARQL11Query ;
	sd:resultFormat	<http://www.w3.org/ns/formats/SPARQL_Results_XML>, <http://www.w3.org/ns/formats/SPARQL_Results_JSON>, <http://www.w3.org/ns/formats/SPARQL_Results_CSV>, <http://www.w3.org/ns/formats/SPARQL_Results_TSV>, <http://www.w3.org/ns/formats/RDF_XML>, <http://www.w3.org/ns/formats/Turtle>, <http://www.w3.org/ns/formats/N-Triples>, <http://www.w3.org/ns/formats/RDF_JSON>, <http://www.w3.org/ns/formats/JSON-LD> ;
	sd:feature	sd:DereferencesURIs, sd:UnionDefaultGraph, sd:BasicFederatedQuery ;
	sd:defaultDataset	:ServiceDataset ;
	dcterms:title	"AOP-Wiki SPARQL Endpoint" ;
	dcterms:description	"SPARQL endpoint for querying Adverse Outcome Pathway data" .

:ServiceDataset	a	sd:Dataset ;
	sd:defaultGraph	<http://aopwiki.org/> ;
	sd:namedGraph	:DataNamedGraph ;
	sd:namedGraph	:VoidNamedGraph ;
	sd:namedGraph	:ServiceDescriptionNamedGraph ;
	dcterms:title	"AOP-Wiki RDF Dataset" ;
	dcterms:description	"Adverse Outcome Pathway data in RDF format" ;
	dcterms:modified	"2026-10-13T16:01:06.127356"^^xsd:dateTime .

:DataNamedGraph	a	sd:NamedGraph ;
	sd:name	<http://aopwiki.org/> ;
	sd:graph	:AOPWikiRDF .

:VoidNamedGraph	a	sd:NamedGraph ;
	sd:name	<http://aopwiki.org/void> .

:ServiceDescriptionNamedGraph	a	sd:NamedGraph ;
	sd:name	<http://aopwiki.org/servicedescription> .

:AOPWikiRDF	a	sd:Graph, void:Dataset .

	aopo:has_key_event	aop.events:2263, aop.events:149, aop.events:2265, aop.events:2266, aop.events:2262, aop.events:2267 ;
	aopo:has_key_event_relationship	aop.relationships:3351, aop.relationships:3356, aop.relationships:3357, aop.relationships:3354, aop.relationships:3355, aop.relationships:3358 ;
	aopo:has_molecular_initiating_event	aop.events:2262 ;

	aopo:has_key_event_relationship	aop.relationships:3135, aop.relationships:2822, aop.relationships:1682, aop.relationships:1676 ;
	aopo:has_molecular_initiating_event	aop.events:244 ;
	aopo:has_adverse_outcome	aop.events:814 ;
	pato:0000047	"Unspecific" ;
	aopo:LifeStageContext	"All life stages" ;

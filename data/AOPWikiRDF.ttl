""" ;
	nci:C25664	"""Cellular""" ;
	nci:C17469	"""Regulation of miRNA expression by DNA replication,damage and repair responses,transcription and translation has been proved in animals like mice,canine and cell line experiments.
""" ;
	pato:0000047	"Female" ;
	aopo:LifeStageContext	"Adult, reproductively mature" ;
	ncbitaxon:131567	ncbitaxon:10095, "WikiUser_25" ;

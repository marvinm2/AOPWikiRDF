	aopo:has_key_event_relationship	aop.relationships:919, aop.relationships:361, aop.relationships:3091, aop.relationships:3298, aop.relationships:3301, aop.relationships:2504, aop.relationships:359, aop.relationships:3300, aop.relationships:3506 ;
	aopo:has_molecular_initiating_event	aop.events:875 ;
	aopo:has_adverse_outcome	aop.events:341 ;

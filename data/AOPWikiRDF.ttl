	aopo:has_key_event_relationship	aop.relationships:45, aop.relationships:5, aop.relationships:252, aop.relationships:94, aop.relationships:337, aop.relationships:255, aop.relationships:315, aop.relationships:1386 ;
	aopo:has_molecular_initiating_event	aop.events:36 ;
	aopo:has_adverse_outcome	aop.events:360 ;

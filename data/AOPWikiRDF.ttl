aop.events:1771
	a	aopo:KeyEvent ;
	dc:identifier	aop.events:1771 ;
	rdfs:label	"KE 1771" ;
	foaf:page	<https://identifiers.org/aop.events/1771> ;
	rdfs:seeAlso	<https://identifiers.org/aop.events/1771> ;
	dc:title	"Decrease, Adenosine triphosphate pool" ;
	dcterms:alternative	"Decrease, ATP pool" ;
	dc:source	"AOPWiki" ;
	dc:description	"""Decreased adenosine triphosphate (ATP) pool describes the loss of balance between ATP synthesis and ATP consumption, leading to reduced total ATP. As a primary form of biological energy, ATP is used by many biological processes  ADDIN EN.CITE
&lt;EndNote&gt;&lt;Cite&gt;&lt;Author&gt;Bonora&lt;/Author&gt;&lt;Year&gt;2012&lt;/Year&gt;&lt;RecNum&gt;4190&lt;/RecNum&gt;&lt;DisplayText&gt;(Bonora

			&nbsp;
		
		
			TG 442A LLNA:DA
			[2]
		
		
			TG 442B LLNA: BrdU-ELISA
			[3]
		
	

""" ;
	nci:C25664	"""Organ""" ;
	nci:C17469	"""Some in vitro assays have been developed using human T cells[1]. Lymph node proliferation is the basis for the in vivo mouse LLNA.
""" ;
	ncbitaxon:131567	"WCS_9606", ncbitaxon:10090 ;
	aopo:OrganContext	uberon:0000029 ;

	dc:title	"Decrease, cholesterol synthesis leads to orofacial clefting" ;
	dcterms:alternative	"Decrease, cholesterol synthesis leads to OFC" ;
	dc:source	"AOPWiki" ;
	dcterms:created	"2023-06-28T08:18:39" ;
	dcterms:modified	"2023-08-31T09:40:10" ;
	dc:description	"""OFC is one of the most common birth defects occurring in approximately 1 in 700 live births. The etiology of OFC is poorly understood and is believed to be a combination of genetic and environmental factors. Understanding the genetic and environmental factors that can lead to OFC is the first step in preventing this birth defect.
""" ;
	dc:creator	"""Jacob I. Reynolds1 , Brian P. Johnson1,2&nbsp; 

1Department of Biomedical Engineering, Institute for Quantitative Health Science and Engineering, Michigan State University, East Lansing, MI

2Department of Pharmacology and Toxicology, Michigan State University, East Lansing, MI
""" ;
	nci:C25688	"Under Development" ;
	dcterms:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	aopo:has_key_event	aop.events:2041, aop.events:1821, aop.events:2043, aop.events:1262, aop.events:2040, aop.events:2028, aop.events:2042 ;

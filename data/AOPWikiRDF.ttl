			&nbsp;
		
		
			
			Phthalates

			(DnHP)
			
			
			rat
			
			
			LOEL=250 mg /kg bw/day
			
			&nbsp;
			
			Anogenital distance decreased
			
			&nbsp;
			
			(Saillenfait, Gallissot, and Sabat&eacute; 2009)
			
		
		
			
			Phthalates

			(DEHP)
			
			
			rat
			
			
			LOEL=300 mg/kg/day
			
			&nbsp;
			

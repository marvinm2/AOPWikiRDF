	aopo:has_key_event_relationship	aop.relationships:3741, aop.relationships:3742, aop.relationships:3740, aop.relationships:3735, aop.relationships:3724, aop.relationships:3745, aop.relationships:1690, aop.relationships:67, aop.relationships:3726, aop.relationships:3727, aop.relationships:3728, aop.relationships:295, aop.relationships:82, aop.relationships:3729, aop.relationships:3730 ;
	aopo:has_molecular_initiating_event	aop.events:2410 ;

aop.relationships:3133
	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:3133 ;
	rdfs:label	"KER 3133" ;
	foaf:page	<https://identifiers.org/aop.relationships/3133> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/3133> ;
	dcterms:created	"2024-02-28T14:53:17" ;
	dcterms:modified	"2024-02-28T14:53:17" ;

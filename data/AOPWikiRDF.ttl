	dcterms:isPartOf	aop:17, aop:26, aop:31, aop:138, aop:171, aop:177, aop:186, aop:200, aop:220, aop:260, aop:284, aop:324, aop:325, aop:326, aop:331, aop:332, aop:333, aop:377, aop:396, aop:411, aop:424, aop:425, aop:429, aop:437, aop:444, aop:447, aop:450, aop:452, aop:457, aop:459, aop:462, aop:464, aop:470, aop:471, aop:472, aop:476, aop:478, aop:479, aop:481, aop:482, aop:483, aop:488, aop:497, aop:501, aop:505, aop:507, aop:509, aop:510, aop:511, aop:521, aop:534, aop:535, aop:538, aop:540, aop:595, aop:596, aop:598, aop:599, aop:600, aop:601, aop:602, aop:603, aop:608, aop:616, aop:622, aop:625, aop:628, aop:642, aop:645, aop:646, aop:647 .

aop.events:1488
	a	aopo:KeyEvent ;
	dc:identifier	aop.events:1488 ;
	rdfs:label	"KE 1488" ;

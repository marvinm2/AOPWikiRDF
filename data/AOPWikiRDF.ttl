	aopo:has_key_event_relationship	aop.relationships:2769, aop.relationships:1977, aop.relationships:2811, aop.relationships:3315, aop.relationships:3316, aop.relationships:2772, aop.relationships:3317, aop.relationships:2774, aop.relationships:3318, aop.relationships:2777, aop.relationships:2784, aop.relationships:2789, aop.relationships:2779, aop.relationships:2780, aop.relationships:2785, aop.relationships:2776 ;
	aopo:has_molecular_initiating_event	aop.events:1686 ;

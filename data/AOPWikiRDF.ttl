	aopo:has_key_event_relationship	aop.relationships:3571, aop.relationships:3574, aop.relationships:3577, aop.relationships:3578, aop.relationships:3579, aop.relationships:3572, aop.relationships:3580, aop.relationships:3573, aop.relationships:3576, aop.relationships:3709, aop.relationships:3710, aop.relationships:188 ;

	aopo:OrganContext	uberon:0002107 ;
	aopo:hasBiologicalEvent	<134_bioevent_0> ;
	go:0008150	go:0042116 ;
	pato:0000001	"increased" ;
	pato:0001241	cl:0000091 ;
	dcterms:isPartOf	aop:624, aop:625, aop:626, aop:627, aop:628, aop:629 .


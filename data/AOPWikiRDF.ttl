{&quot;citationItems&quot;:[{&quot;id&quot;:&quot;ITEM-1&quot;,&quot;itemData&quot;:{&quot;DOI&quot;:&quot;10.1016/0048-3575(79)90098-1&quot;,&quot;ISSN&quot;:&quot;10959939&quot;,&quot;abstract&quot;:&quot;The

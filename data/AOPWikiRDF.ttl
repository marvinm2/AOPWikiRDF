	aopo:has_key_event_relationship	aop.relationships:1026, aop.relationships:1035, aop.relationships:1034, aop.relationships:2212, aop.relationships:2013 ;
	aopo:has_molecular_initiating_event	aop.events:1002 ;
	aopo:has_adverse_outcome	aop.events:351, aop.events:360 ;

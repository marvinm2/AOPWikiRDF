	aopo:has_key_event_relationship	aop.relationships:2009, aop.relationships:2776, aop.relationships:3373, aop.relationships:3374, aop.relationships:3376, aop.relationships:3442, aop.relationships:3443 ;
	aopo:has_molecular_initiating_event	aop.events:1115 ;
	nci:C54571	aop.stressor:303 ;
	aopo:LifeStageContext	"Adults" .


	ncbitaxon:131567	"WCS_9606", ncbitaxon:10116, ncbitaxon:9395, "WCS_8022", ncbitaxon:10141, ncbitaxon:10036, ncbitaxon:9031, "WCS_9103", "WCS_9913", ncbitaxon:9823, ncbitaxon:9615, ncbitaxon:9685, ncbitaxon:9544 .

aop:48
	a	aopo:AdverseOutcomePathway ;
	dc:identifier	aop:48 ;

aop.relationships:2435
	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:2435 ;
	rdfs:label	"KER 2435" ;
	foaf:page	<https://identifiers.org/aop.relationships/2435> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/2435> ;

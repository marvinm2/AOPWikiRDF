	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:436 ;
	rdfs:label	"KER 436" ;
	foaf:page	<https://identifiers.org/aop.relationships/436> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/436> ;

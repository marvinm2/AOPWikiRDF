<http://rdfs.org/ns/void#Dataset>	rdfs:label	"Dataset".

<http://edamontology.org/data_1027>	rdfs:label	"Gene ID (NCBI)";
	dc:description	"""An NCBI unique identifier of a gene.""".

<http://edamontology.org/data_1025>	rdfs:label	"Gene identifier";
	dc:description	"""An identifier of a gene, such as a name/symbol or a unique identifier of a gene in a database.""".

<http://edamontology.org/data_2298>	rdfs:label	"Gene ID (HGNC)";
	dc:description	"""Identifier for a gene approved by the HUGO Gene Nomenclature Committee.""".

<http://purl.org/obo/owl/GO#0008150>	rdfs:label	"biological_process";
	dc:description	"""A biological process represents a specific objective that the organism is genetically programmed to achieve. Biological processes are often described by their outcome or ending state, e.g., the biological process of cell division results in the creation of two daughter cells (a divided cell) from a single parent cell. A biological process is accomplished by a particular set of molecular functions carried out by specific gene products (or macromolecular complexes), often in a highly regulated manner and in a particular temporal sequence. Note that, in addition to forming the root of the biological process ontology, this term is recommended for use for the annotation of gene products whose biological process is unknown. When this term is used for annotation, it indicates that no information was available about the biological process of the gene product annotated as of the date the annotation was made; the evidence code 'no data' (ND), is used to indicate this.""".

<http://aopkb.org/aop_ontology#CellTypeContext>	rdfs:label	"Cell-term".

<http://aopkb.org/aop_ontology#OrganContext>	rdfs:label	"Organ-term".

<http://semanticscience.org/resource/CHEMINF_000407>	rdfs:label	"ChEBI identifier";
	dc:description	"""Database identifier used by ChEBI.""".

<http://semanticscience.org/resource/CHEMINF_000412>	rdfs:label	"ChEMBL identifier";
	dc:description	"""Identifier used by the ChEMBL database for compounds, assays, target, etc.""".

<http://semanticscience.org/resource/CHEMINF_000405>	rdfs:label	"ChemSpider identifier";
	dc:description	"""Database identifier used by ChemSpider.""".

<http://semanticscience.org/resource/CHEMINF_000406>	rdfs:label	"DrugBank identifier";
	dc:description	"""Database identifier used by DrugBank.""".

<http://semanticscience.org/resource/CHEMINF_000408>	rdfs:label	"HMDB identifier";
	dc:description	"""Database identifier used by Human Metabolome Database.""".

<http://semanticscience.org/resource/CHEMINF_000409>	rdfs:label	"KEGG identifier";
	dc:description	"""Database identifier used by KEGG.""".

<http://semanticscience.org/resource/CHEMINF_000564>	rdfs:label	"LipidMaps identifier";
	dc:description	"""Identifier used by the LipidMaps database, http://www.lipidmaps.org/.""".

<http://semanticscience.org/resource/CHEMINF_000140>	rdfs:label	"PubChem compound identifier (CID)".

<http://semanticscience.org/resource/CHEMINF_000567>	rdfs:label	"Wikidata identifier";
	dc:description	"""Database identifier used by Wikidata.""".

<http://rdfs.org/ns/void#Linkset>	rdfs:label	"Linkset".

<http://aopkb.org/aop_ontology#KeyEvent>	rdfs:label	"Key Event".

<http://aopkb.org/aop_ontology#KeyEventRelationship>	rdfs:label	"Key Event Relationship".

<http://edamontology.org/data_1033>	rdfs:label	"Ensembl gene ID";
	dc:description	"""Unique identifier for a gene (or other feature) from the Ensembl database.""".

<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C54571>	rdfs:label	"Stressor";
	dc:description	"""An agent, stimulus, activity, or event that causes stress on an organism, speeds up a reaction rate, or keeps a reaction rate the same.""".

<http://aopkb.org/aop_ontology#AdverseOutcomePathway>	rdfs:label	"Adverse Outcome Pathway".

<http://semanticscience.org/resource/CHEMINF_000000>	rdfs:label	"chemical entity";
	dc:description	"""A chemical entity is any molecular entity or chemical substance.""".

<http://semanticscience.org/resource/CHEMINF_000446>	rdfs:label	"CAS registry number";
	dc:description	"""Identifier used by the Chemical Abstracts Service database.""".

<http://edamontology.org/data_2291>	rdfs:label	"UniProt ID";
	dc:description	"""An identifier of a polypeptide in the UniProt database.""".

<http://purl.bioontology.org/ontology/NCBITAXON/131567>	rdfs:label	"cellular organisms".

<http://purl.obolibrary.org/obo/PATO_0001241>	rdfs:label	"physical object quality";
	dc:description	"""A quality which inheres in a continuant""".


	pato:0000001	"increased" ;
	pato:0001241	cl:0000128 ;
	dcterms:isPartOf	aop:543, aop:544 .

aop.events:2266
	a	aopo:KeyEvent ;
	dc:identifier	aop.events:2266 ;
	rdfs:label	"KE 2266" ;
	foaf:page	<https://identifiers.org/aop.events/2266> ;
	rdfs:seeAlso	<https://identifiers.org/aop.events/2266> ;
	dc:title	"Demyelination, increased" ;
	dcterms:alternative	"Demyelination, increased" ;
	dc:source	"AOPWiki" ;
	dc:description	"""
Demyelination is defined by the loss of myelin sheaths in nervous tissue, typically following insult from injury or disease. Demyelination is initiated by fractioning of myelin lamellae followed by removal of the fragments by proteolytic and lipolytic enzymes that can digest the myelin pieces (Cuzner &amp; Norton, 1996; H&ouml;ftberger &amp; Lassmann, 2017). Considering myelin functions to maintain axon functionality and survival, once myelin is lost neurodegeneration ensues (Ohno &amp; Ikenaka, 2019).&nbsp; Demyelinating lesions can occur anywhere within the CNS including on myelin surrounding axons of both sensory and motor neurons (H&ouml;ftberger &amp; Lassmann, 2017).

""" ;
	nci:C25664	"""Cellular""" ;
	pato:0000047	"Unspecific" ;
	ncbitaxon:131567	ncbitaxon:9606 ;
	aopo:OrganContext	uberon:0001016 ;
	aopo:hasBiologicalEvent	<2266_bioevent_0>, <2266_bioevent_1> ;
	go:0008150	hp:0007305, mp:0000921 ;
	pato:0000001	"increased" ;
	dcterms:isPartOf	aop:543, aop:544, aop:610 .


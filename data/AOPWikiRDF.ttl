	aopo:has_key_event	aop.events:2323, aop.events:2324, aop.events:2326, aop.events:18, aop.events:1971 ;
	aopo:has_key_event_relationship	aop.relationships:3533, aop.relationships:3534, aop.relationships:3538, aop.relationships:3541 ;
	aopo:has_molecular_initiating_event	aop.events:18 ;
	aopo:has_adverse_outcome	aop.events:1971 ;

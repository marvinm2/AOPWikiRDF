	aopo:has_key_event	aop.events:1392, aop.events:1634, aop.events:155, aop.events:1635, aop.events:1505, aop.events:1821, aop.events:1115, aop.events:1521 ;
	aopo:has_key_event_relationship	aop.relationships:2009, aop.relationships:2810, aop.relationships:1909, aop.relationships:1910, aop.relationships:3480, aop.relationships:3363, aop.relationships:2205 ;
	aopo:has_molecular_initiating_event	aop.events:1115 ;
	aopo:has_adverse_outcome	aop.events:1521 ;
	nci:C54571	aop.stressor:454, aop.stressor:44, aop.stressor:457, aop.stressor:451, aop.stressor:274, aop.stressor:711, aop.stressor:252, aop.stressor:675 ;
	pato:0000047	"Unspecific" ;

	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:2440 ;
	rdfs:label	"KER 2440" ;
	foaf:page	<https://identifiers.org/aop.relationships/2440> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/2440> ;

	dc:title	"Alcohol dehydrogenase leading to reproductive dysfunction" ;
	dcterms:alternative	"Alcohol dehydrogenase leading to reproductive dysfunction" ;
	dc:source	"AOPWiki" ;
	dcterms:created	"2022-08-28T20:07:22" ;
	dcterms:modified	"2024-10-07T19:05:18" ;
	dc:creator	"""Ihn-Sil Kwak1,2, Donggon Yoo3,4&nbsp;, Tae-Yong&nbsp;Jeong5, Woo-Keun Kim3,4*

&nbsp;

1.&nbsp;Fisheries Science Institute, Chonnam National University, Yeosu, 59626, Korea


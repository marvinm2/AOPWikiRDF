aop.relationships:2838
	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:2838 ;
	rdfs:label	"KER 2838" ;
	foaf:page	<https://identifiers.org/aop.relationships/2838> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/2838> ;

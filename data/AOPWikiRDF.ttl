	aopo:has_key_event_relationship	aop.relationships:581, aop.relationships:583, aop.relationships:1145, aop.relationships:1150, aop.relationships:1151, aop.relationships:1311, aop.relationships:1310, aop.relationships:1146 ;
	aopo:has_molecular_initiating_event	aop.events:559 ;
	aopo:has_adverse_outcome	aop.events:563 ;
	ncbitaxon:131567	"WikiUser_2" .


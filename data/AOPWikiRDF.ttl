	aopo:has_upstream_key_event	aop.events:1218 ;
	aopo:has_downstream_key_event	aop.events:1220 ;
	dc:description	"""Sufficient depolarization of the neuronal membrane from increased calcium may trigger voltage-gated sodium channels leading to propagation of action potential(s).
""" ;
	edam:data_2042	"""The basic biology of neuronal action potentials is outside the scope of this review, but is widely available in textbooks and online educational resources.
""" ;
	dcterms:isPartOf	aop:196 .


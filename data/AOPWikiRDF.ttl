	aopo:has_key_event_relationship	aop.relationships:2450, aop.relationships:2447, aop.relationships:2448, aop.relationships:2442, aop.relationships:2443 ;
	aopo:has_molecular_initiating_event	aop.events:1392 ;
	aopo:has_adverse_outcome	aop.events:1250 ;

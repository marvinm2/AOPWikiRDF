{&quot;citationItems&quot;:[{&quot;id&quot;:&quot;ITEM-1&quot;,&quot;itemData&quot;:{&quot;author&quot;:[{&quot;dropping-particle&quot;:&quot;&quot;,&quot;family&quot;:&quot;Lehmann&quot;,&quot;given&quot;:&quot;Paul

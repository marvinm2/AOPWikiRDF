	dcterms:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	aopo:has_key_event	aop.events:1158, aop.events:295, aop.events:961, aop.events:281, aop.events:1157, aop.events:1101 ;
	aopo:has_key_event_relationship	aop.relationships:1204, aop.relationships:1205, aop.relationships:2237, aop.relationships:2478, aop.relationships:2270, aop.relationships:2479, aop.relationships:2168 ;

	aopo:has_molecular_initiating_event	aop.events:804 ;
	aopo:has_adverse_outcome	aop.events:330 ;
	pato:0000047	"Male" ;
	aopo:LifeStageContext	"Fetal" ;
	ncbitaxon:131567	ncbitaxon:10117 .


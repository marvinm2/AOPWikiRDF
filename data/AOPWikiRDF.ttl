aop:447
	a	aopo:AdverseOutcomePathway ;
	dc:identifier	aop:447 ;
	rdfs:label	"AOP 447" ;
	rdfs:seeAlso	<https://identifiers.org/aop/447> ;
	foaf:page	<https://identifiers.org/aop/447> ;
	dc:title	"Kidney failure induced by inhibition of mitochondrial electron transfer chain through apoptosis, inflammation and oxidative stress pathways" ;
	dcterms:alternative	"Kidney failure induced by inhibition of mitochondrial ETC" ;
	dc:source	"AOPWiki" ;
	dcterms:created	"2022-04-08T07:56:32" ;
	dcterms:modified	"2024-07-04T11:27:10" ;
	dc:creator	"""Institut de Radioprotection et de S&ucirc;ret&eacute; Nucl&eacute;aire (IRSN), PSE-SANTE, SESANE, Fontenay-aux-Roses, France
""" ;
	dcterms:abstract	"""U metal-ions are filtered through the glomerular membrane of the kidneys, then concentrate in cortical and juxtaglomerular areas and bind to the brush border membrane of the proximal convoluted tubules. U uptake by epithelial cells occurs through endocytosis and the sodium-dependent phosphate co-transporter (NaPi-IIa). Molecular key events start with U induce mitochondrial ETC inhibition (KE1), decrease MMP (KE2) and mitochondrial disruption (KE3). The collapse of mitochondrial membrane potential triggers the Nrf2 (KE3), NF-&kappa;B (KE4) or endoplasmic reticulum-stress (KE5) pathways. The resulting cellular key events include oxidative stress (KE6), apoptosis (KE7), and pro-inflammatory effects (KE8). Finally, the main adverse outcome is tubular cell necrosis (KE9), leading to kidney toxicity (KE10) and then kidney failure (AO).
""" ;
	dcterms:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	aopo:has_key_event	aop.events:105, aop.events:1770, aop.events:177, aop.events:1917, aop.events:202, aop.events:1815, aop.events:1392, aop.events:1365, aop.events:1633, aop.events:1097, aop.events:814, aop.events:759 ;
	aopo:has_key_event_relationship	aop.relationships:2636, aop.relationships:3163, aop.relationships:3164, aop.relationships:3165, aop.relationships:3131, aop.relationships:2641, aop.relationships:3271, aop.relationships:2643, aop.relationships:2644, aop.relationships:3264, aop.relationships:2645, aop.relationships:2646, aop.relationships:2647, aop.relationships:2648 ;
	aopo:has_adverse_outcome	aop.events:759 ;
	nci:C54571	aop.stressor:664, aop.stressor:738 .


aop.relationships:2249
	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:2249 ;
	rdfs:label	"KER 2249" ;
	foaf:page	<https://identifiers.org/aop.relationships/2249> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/2249> ;
	dcterms:created	"2020-12-09T15:13:43" ;
	dcterms:modified	"2020-12-09T15:13:43" ;
	aopo:has_upstream_key_event	aop.events:1830 ;

	ncbitaxon:131567	ncbitaxon:9666, ncbitaxon:9669, ncbitaxon:9685, "WCS_9615", ncbitaxon:10036, ncbitaxon:9544, ncbitaxon:9595, ncbitaxon:9541, ncbitaxon:9534, "WCS_9606", ncbitaxon:9833, ncbitaxon:447135, ncbitaxon:61383, ncbitaxon:9696, ncbitaxon:419130, ncbitaxon:29064, ncbitaxon:61388, ncbitaxon:9678, ncbitaxon:94180, ncbitaxon:9874, "WCS_452646", ncbitaxon:9651, ncbitaxon:9689, ncbitaxon:9823, ncbitaxon:9986, ncbitaxon:10185, ncbitaxon:452597, ncbitaxon:9627, ncbitaxon:34880, ncbitaxon:37347, "WCS_9913", ncbitaxon:9872, ncbitaxon:230844, ncbitaxon:58060, ncbitaxon:9483, ncbitaxon:9555 .

aop:431
	a	aopo:AdverseOutcomePathway ;

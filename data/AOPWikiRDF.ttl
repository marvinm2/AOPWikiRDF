	aopo:has_key_event_relationship	aop.relationships:2769, aop.relationships:2832, aop.relationships:3316, aop.relationships:2833, aop.relationships:2834, aop.relationships:2835, aop.relationships:2836, aop.relationships:3321, aop.relationships:2841, aop.relationships:2811, aop.relationships:1977, aop.relationships:3315, aop.relationships:2837, aop.relationships:2838, aop.relationships:2839 ;
	aopo:has_molecular_initiating_event	aop.events:1686 ;
	aopo:has_adverse_outcome	aop.events:341 ;

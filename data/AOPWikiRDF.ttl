aop.relationships:2894
	a	aopo:KeyEventRelationship ;
	dc:identifier	aop.relationships:2894 ;
	rdfs:label	"KER 2894" ;
	foaf:page	<https://identifiers.org/aop.relationships/2894> ;
	rdfs:seeAlso	<https://identifiers.org/aop.relationships/2894> ;

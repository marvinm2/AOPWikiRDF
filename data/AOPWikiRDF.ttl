	aopo:has_key_event_relationship	aop.relationships:2568, aop.relationships:2569, aop.relationships:2570, aop.relationships:2571, aop.relationships:2572, aop.relationships:2573, aop.relationships:2574, aop.relationships:1306, aop.relationships:2575, aop.relationships:2577, aop.relationships:3137, aop.relationships:3138, aop.relationships:3139 ;
	aopo:has_molecular_initiating_event	aop.events:18 ;
	aopo:has_adverse_outcome	aop.events:1982 ;
